---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
---
<Base>
  <h1>Hi, I'm Thiago. I build data products and backend services.</h1>
  <p class="lead">
    Based in Elche, Spain. I turn messy data and real-world rules into things that run in production: APIs,
    pipelines, dashboards and AI agents. Every project below has its code on GitHub, and most have a live demo.
  </p>
  <div class="cta">
    <a class="btn primary" href="#projects">See projects</a>
    <a class="btn" href="/cv/Thiago_Bastos_CV_en.pdf">Download CV (EN)</a>
    <a class="btn" href="/cv/Thiago_Bastos_CV_es.pdf">CV (ES)</a>
  </div>

  <h2 id="projects">Projects</h2>
  <div class="grid">
    {projects.map((p) => (
      <a class="card" href={`/projects/${p.slug}`} style="color:inherit">
        <img src={p.image} alt={`${p.title} screenshot`} loading="lazy" />
        <div class="body">
          <h3>{p.title}</h3>
          <p>{p.tagline}</p>
          <ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
        </div>
      </a>
    ))}
  </div>
</Base>
