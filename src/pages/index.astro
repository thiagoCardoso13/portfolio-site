---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
const skills = [
  { ico: '{ }', title: 'Backend & APIs', text: 'REST APIs with Java, Spring Boot and PostgreSQL, tested on a real database and deployed with CI/CD.', hot: false },
  { ico: '▦', title: 'Data & Analytics', text: 'Pipelines in Python and SQL, from raw job offers to a clear dashboard anyone can explore.', hot: true },
  { ico: '◈', title: 'AI Agents', text: 'LLM agents and RAG assistants with guardrails, cited sources and a visible trail of every step.', hot: false },
];
const stats = [
  { n: '5', l: 'Live projects' },
  { n: '160', l: 'Automated tests' },
  { n: '570', l: 'Job offers analysed' },
  { n: '4', l: 'LLM providers supported' },
];
---
<Base>
  <section class="wrap hero">
    <div class="hero-photo">
      <img src="/img/thiago-round.jpg" width="800" height="800" alt="Portrait of Thiago Bastos" fetchpriority="high" />
    </div>
    <div class="hero-copy">
      <p class="eyebrow">Hello, I'm Thiago</p>
      <h1>Data &amp; Backend Developer</h1>
      <p class="lead">
        Based in Elche, Spain. I turn messy data and real-world rules into things that run in production: APIs,
        pipelines, dashboards and AI agents. Every project below has its code on GitHub and a live demo you can try.
      </p>
      <div class="btn-row">
        <a class="btn" href="/about">About me</a>
        <a class="btn ghost" href="#projects">See projects</a>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="cards3">
      {skills.map((s) => (
        <div class:list={['skill', { hot: s.hot }]}>
          <span class="ico" aria-hidden="true">{s.ico}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section">
    <div class="stats">
      <div class="stat-big"><b>2026</b><span>Building in public</span></div>
      <div class="stat-grid">
        {stats.map((s) => <div class="stat"><b>{s.n}</b><span>{s.l}</span></div>)}
      </div>
    </div>
  </section>

  <section class="wrap section" id="projects">
    <div class="section-head">
      <div>
        <h2>Featured projects</h2>
        <p>Each one is live, tested and documented.</p>
      </div>
    </div>
    <div class="grid">
      {projects.map((p) => (
        <a class="pcard" href={`/projects/${p.slug}`}>
          <div class="shot"><img src={p.image} alt={`${p.title} screenshot`} loading="lazy" /></div>
          <h3>{p.title}</h3>
          <p>{p.tagline}</p>
          <span class="more">Know more →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap section" id="contact">
    <div class="cta-box">
      <div>
        <h2>Let's work together</h2>
        <p>I'm looking for my first role in data or backend development. Open to on site, hybrid or remote.</p>
      </div>
      <div class="btn-row" style="margin:0">
        <a class="btn" href="mailto:thiagobafc@gmail.com">Contact</a>
        <a class="btn ghost" href="/cv/Thiago_Bastos_CV_en.pdf">CV (EN)</a>
        <a class="btn ghost" href="/cv/Thiago_Bastos_CV_es.pdf">CV (ES)</a>
      </div>
    </div>
  </section>
</Base>
