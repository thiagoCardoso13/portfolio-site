---
import Base from '../layouts/Base.astro';
const skills = ['Python', 'SQL', 'Java', 'Spring Boot', 'PostgreSQL', 'DuckDB', 'Docker', 'GitHub Actions', 'Streamlit', 'LangGraph'];
---
<Base title="About · Thiago Bastos">
  <div class="wrap about">
    <img src="/img/thiago.jpg" width="719" height="1100" alt="Portrait of Thiago Bastos" />
    <div class="prose">
      <p class="eyebrow">About me</p>
      <h1>Rules, data and things that ship</h1>
      <p>
        I'm a data and software developer based in Elche, Spain, looking for my first full-time role. I like problems
        where the rules matter: concurrent bookings, noisy job-market data, questions that need a careful query.
        I write the tests, document the trade-offs and ship the result so anyone can try it.
      </p>
      <h2>Skills</h2>
      <ul class="tags">{skills.map((s) => <li>{s}</li>)}</ul>
      <h2>Get in touch</h2>
      <p>
        The fastest way to reach me is <a href="mailto:thiagobafc@gmail.com">thiagobafc@gmail.com</a> or
        <a href="https://www.linkedin.com/in/thiagocardoso13/">LinkedIn</a>. My code is on
        <a href="https://github.com/thiagoCardoso13">GitHub</a>.
      </p>
      <div class="btn-row">
        <a class="btn" href="/cv/Thiago_Bastos_CV_en.pdf">Download CV (EN)</a>
        <a class="btn ghost" href="/cv/Thiago_Bastos_CV_es.pdf">CV (ES)</a>
      </div>
    </div>
  </div>
</Base>
