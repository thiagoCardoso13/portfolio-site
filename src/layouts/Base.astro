---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
interface Props { title?: string; description?: string }
const { title = 'Thiago Bastos · Data & Backend Developer', description = 'Data and backend developer in Elche, Spain. Live projects, CV and contact.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://portfolio-site-dusky-iota.vercel.app/img/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <header class="wrap nav">
      <a href="/" class="logo" aria-label="Thiago Bastos, home"><span>TB</span></a>
      <nav>
        <a href="/" class:list={[{ active: path === '/' }]}>Home</a>
        <a href="/#projects">Projects</a>
        <a href="/about" class:list={[{ active: path.startsWith('/about') }]}>About</a>
        <a href="/#contact">Contact</a>
        <a class="nav-cv" href="/cv/Thiago_Bastos_CV_en.pdf">CV</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="wrap foot">
      <span>© 2026 Thiago Bastos · Elche, Spain</span>
      <span class="foot-links">
        <a href="https://github.com/thiagoCardoso13">GitHub</a>
        <a href="https://www.linkedin.com/in/thiagocardoso13/">LinkedIn</a>
        <a href="mailto:thiagobafc@gmail.com">Email</a>
      </span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0b0c; --surface: #151517; --surface-2: #1c1c1f; --line: #26262a;
    --fg: #ffffff; --muted: #a2a2aa;
    --red: #d62828; --red-text: #ff5a5f; --red-deep: #b01e1e;
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 400 16px/1.7 'Poppins', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 1.5rem; }
  a { color: var(--red-text); text-decoration: none; }
  a:hover { text-decoration: underline; }
  h1, h2, h3 { line-height: 1.2; margin: 0; }
  h1 { font-size: clamp(2rem, 5vw, 3.1rem); font-weight: 700; }
  h2 { font-size: 1.15rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow { color: var(--red-text); font-weight: 600; font-size: .9rem; margin: 0 0 .6rem; }
  .muted { color: var(--muted); }

  /* nav */
  .nav { display: flex; justify-content: space-between; align-items: center; padding-top: 1.4rem; padding-bottom: 1.4rem; }
  .logo span { display: inline-grid; place-items: center; width: 40px; height: 40px; border: 2px solid var(--red); border-radius: 10px; color: var(--fg); font-weight: 700; font-size: .95rem; letter-spacing: .02em; }
  .logo:hover { text-decoration: none; }
  .logo:hover span { background: var(--red); }
  .nav nav { display: flex; align-items: center; gap: 1.6rem; font-size: .78rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }
  .nav nav a { color: var(--fg); }
  .nav nav a:hover, .nav nav a.active { color: var(--red-text); text-decoration: none; }
  .nav-cv { border: 1px solid var(--red); padding: .35rem .9rem; border-radius: 6px; }

  /* buttons */
  .btn { display: inline-block; padding: .7rem 1.5rem; border-radius: 6px; background: var(--red); color: #fff; font-weight: 600; font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; border: 1px solid var(--red); }
  .btn:hover { background: var(--red-deep); border-color: var(--red-deep); text-decoration: none; }
  .btn.ghost { background: transparent; color: var(--fg); border-color: var(--line); }
  .btn.ghost:hover { border-color: var(--red); color: var(--red-text); background: transparent; }
  .btn-row { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 1.6rem; }

  /* hero */
  .hero { display: grid; grid-template-columns: minmax(240px, 360px) 1fr; gap: 4rem; align-items: center; padding-top: 2rem; }
  .hero-photo { position: relative; padding: 12px; }
  .hero-photo img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 50%; }
  .hero-copy { padding-bottom: 0; }
  .hero-copy p.lead { color: var(--muted); max-width: 34rem; margin: 1.1rem 0 0; }

  /* section */
  .section { padding: 4.5rem 0 0; }
  .section-head { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.8rem; }
  .section-head p { margin: .4rem 0 0; color: var(--muted); font-size: .9rem; }

  /* skill cards */
  .cards3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .skill { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 1.7rem 1.5rem; }
  .skill.hot { background: var(--red); border-color: var(--red); }
  .skill .ico { font-size: 1.5rem; color: var(--red-text); font-weight: 700; margin-bottom: 1rem; display: block; font-family: ui-monospace, 'SF Mono', Menlo, monospace; }
  .skill.hot .ico { color: #fff; }
  .skill h3 { font-size: 1.05rem; font-weight: 600; }
  .skill p { margin: .5rem 0 0; font-size: .88rem; color: var(--muted); }
  .skill.hot p { color: rgba(255,255,255,.9); }

  /* stats */
  .stats { display: grid; grid-template-columns: 1fr 1.6fr; gap: 2rem; align-items: center; }
  .stat-big { text-align: center; }
  .stat-big b { display: block; font-size: clamp(3.5rem, 9vw, 5.5rem); line-height: 1; color: var(--red-text); font-weight: 700; }
  .stat-big span { font-weight: 600; }
  .stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .stat { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 1.1rem 1rem; text-align: center; }
  .stat b { display: block; font-size: 1.7rem; font-weight: 700; color: var(--red-text); }
  .stat span { font-size: .78rem; color: var(--muted); }

  /* project cards */
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 1.4rem; }
  .pcard { display: block; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 1rem; color: var(--fg); transition: border-color .15s, transform .15s; }
  .pcard:hover { border-color: var(--red); transform: translateY(-3px); text-decoration: none; }
  .pcard .shot { aspect-ratio: 16 / 10; overflow: hidden; border-radius: 6px; background: var(--surface-2); }
  .pcard img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .pcard h3 { font-size: 1.05rem; margin: 1rem 0 .3rem; font-weight: 600; }
  .pcard p { margin: 0 0 .9rem; font-size: .85rem; color: var(--muted); }
  .more { font-size: .72rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--red-text); }
  .tags { display: flex; gap: .4rem; flex-wrap: wrap; padding: 0; margin: 0 0 .9rem; list-style: none; }
  .tags li { font-size: .72rem; padding: .12rem .6rem; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); }

  /* CTA */
  .cta-box { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 2rem 2.2rem; }
  .cta-box h2 { text-transform: none; letter-spacing: 0; font-size: 1.5rem; }
  .cta-box p { margin: .4rem 0 0; color: var(--muted); font-size: .92rem; }

  /* detail pages */
  .page-top { padding-top: 2.5rem; }
  .page-top .lead { color: var(--muted); max-width: 40rem; margin: 1rem 0 0; }
  .hero-img { display: block; width: 100%; border: 1px solid var(--line); border-radius: 8px; margin: 2rem 0 1.4rem; }
  .prose { max-width: 44rem; }
  .prose h2 { margin: 2.6rem 0 .8rem; color: var(--red-text); font-size: .95rem; }
  .prose ul { padding-left: 1.2rem; }
  .prose ul.tags { padding-left: 0; }
  .prose li { margin: .4rem 0; color: #d9d9de; }
  .prose p { color: #d9d9de; }
  .about { display: grid; grid-template-columns: minmax(220px, 320px) 1fr; gap: 4rem; align-items: center; padding-top: 3rem; }
  .about > img { margin: 12px; width: calc(100% - 24px); }
  .about img { width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 50%; display: block; }

  .foot { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; color: var(--muted); border-top: 1px solid var(--line); margin-top: 5rem; padding-top: 1.4rem; padding-bottom: 2rem; font-size: .82rem; }
  .foot-links { display: flex; gap: 1.2rem; }

  @media (max-width: 820px) {
    .hero, .about, .stats { grid-template-columns: 1fr; }
    .hero-photo { max-width: 280px; margin: 0 auto; }
    .about > img { max-width: 260px; margin: 12px auto; }
    .hero-copy { padding-bottom: 0; text-align: left; }
    .cards3 { grid-template-columns: 1fr; }
    .nav nav { gap: .9rem; font-size: .68rem; }
    .nav nav a:nth-child(2) { display: none; }
  }
</style>
